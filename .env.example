# Copy this file to .env and fill in your own values

# Secret used to sign login tokens. Use any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# Your Anthropic API key, for the AI chat tutor feature.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Port the backend server runs on
PORT=4000

# Postgres connection string from Supabase or Neon.
# Supabase: Project Settings -> Database -> Connection string -> URI
# Neon: Dashboard -> Connection Details -> Connection string
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

